<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.2.xsd">
    <changeSet id="0006_1" author="matt">

        <createTable tableName="product">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="part_number" type="VARCHAR(10)"/>
            <column name="name" type="VARCHAR(200)"/>
            <column name="retail_price_netto" type="DECIMAL(19,4)"/>
            <column name="retail_price_brutto" type="DECIMAL(19,4)"/>
            <column name="cc" type="double"/>
            <column name="vat" type="integer"/>



        </createTable>

    </changeSet>

</databaseChangeLog>